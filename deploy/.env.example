# SimpleSuite Self-Hosting Environment Configuration
# Copy this file to .env and run ./deploy/scripts/generate-secrets.sh to populate secrets.

# === Public (browser-safe) ===
# The URL where the Kong API gateway is accessible from the browser.
# This is passed to supabase-js and must be reachable by end users.
SUPABASE_PUBLIC_URL=http://localhost:8000

# Browser-safe JWT with the "anon" role, used by supabase-js for unauthenticated API access.
# Generated automatically by generate-secrets.sh.
ANON_KEY=

# === Private (backend-only) ===
# JWT with the "service_role" role. Must NEVER be exposed to browser clients.
# Generated automatically by generate-secrets.sh.
SERVICE_ROLE_KEY=

# Cryptographic secret used to sign ANON_KEY and SERVICE_ROLE_KEY JWTs.
# Must NEVER be exposed to browser clients.
# Generated automatically by generate-secrets.sh.
JWT_SECRET=

# Password for the Postgres database superuser.
# Must NEVER be exposed to browser clients.
# Generated automatically by generate-secrets.sh.
POSTGRES_PASSWORD=

# === Optional ===
# Username for the Supabase Studio dashboard (if enabled).
DASHBOARD_USERNAME=admin

# Password for the Supabase Studio dashboard.
# Generated automatically by generate-secrets.sh.
DASHBOARD_PASSWORD=

# === Push Notifications (optional) ===
# VAPID key pair for Web Push notifications.
# Generate with: npx web-push generate-vapid-keys
# The public key is injected into the frontend; the private key is used by the notify worker.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# How often (in ms) the notification worker checks for due items.
# Default: 900000 (15 minutes)
CHECK_INTERVAL_MS=900000

# === Frontend ===
# Which frontend app to deploy. Options: simplebudget, simpletracker
# Only used when running with compose.frontend.yml (single app mode).
FRONTEND_APP=simplebudget

# Port on which the self-hosted frontend container is exposed.
# Only used when running with compose.frontend.yml (single app mode).
FRONTEND_PORT=8080

# Ports for hosting both apps simultaneously (compose.allfrontends.yml).
SIMPLEBUDGET_PORT=8080
SIMPLETRACKER_PORT=8081
