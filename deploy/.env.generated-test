# === Frontend ===
# Which frontend app to deploy. Options: simplebudget, simpletracker
# Only used when running with compose.frontend.yml (single app mode).
FRONTEND_APP=simplebudget

# Port on which the self-hosted frontend container is exposed.
# Only used when running with compose.frontend.yml (single app mode).
FRONTEND_PORT=8080

# Ports for hosting both apps simultaneously (compose.allfrontends.yml).
SIMPLEBUDGET_PORT=8080
SIMPLETRACKER_PORT=8081
